# Copy to .env.local (ignored by git). Never put a secret with server powers in a VITE_ variable: everything VITE_ is
# baked into the public bundle.

# The Supabase project. The anon key is public by design; row-level security protects the data.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Development only. With this set, a key typed into Settings sends AI calls straight from the browser instead of
# through the Edge Function. Leave unset for a real build.
# VITE_AI_DIRECT=1

# Public analytics ids. Placeholders until launch; see LAUNCH_CHECKLIST.md.
VITE_META_PIXEL_ID=PLACEHOLDER
VITE_VAPID_PUBLIC_KEY=PLACEHOLDER
