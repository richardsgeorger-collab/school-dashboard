# Server-side secrets for the Edge Functions. Set with `supabase secrets set --env-file supabase/functions/.env`
# (the .env file is ignored by git). None of these ever reach the browser. Values left blank on purpose: the
# secrets scanner fails the build on anything key-shaped, even a placeholder.
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the platform automatically.
