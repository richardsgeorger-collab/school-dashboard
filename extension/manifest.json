{
  "manifest_version": 3,
  "name": "Halo+ for GCU: Calendar, Search & Due Dates on Halo",
  "description": "Makes GCU's Halo better right on the page: search, one calendar for all classes, what's next on every class, rubrics and more.",
  "version": "0.12.8",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://halo.gcu.edu/*",
    "https://haloplus.app/*",
    "https://richardsgeorger-collab.github.io/*",
    "https://kiacmspgvntzwngijibr.supabase.co/functions/v1/sync-drop",
    "https://kiacmspgvntzwngijibr.supabase.co/functions/v1/report"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Halo+",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://halo.gcu.edu/*"
      ],
      "js": [
        "halo-model.js",
        "celebrate.js",
        "content-halo.js",
        "onhalo/features.js",
        "onhalo/logic.js",
        "onhalo/core.js",
        "onhalo/cards.js",
        "halo-ui.js",
        "onhalo/search.js",
        "onhalo/drafts.js",
        "onhalo/words.js",
        "onhalo/rubric.js",
        "onhalo/duein.js",
        "onhalo/topic.js",
        "onhalo/calendar.js",
        "onhalo/homecal.js",
        "onhalo/homeheader.js",
        "onhalo/homecards.js",
        "onhalo/views.js",
        "onhalo/submit.js",
        "onhalo/feedback.js",
        "onhalo/participation.js",
        "onhalo/links.js",
        "onhalo/files.js",
        "onhalo/counts.js",
        "onhalo/preload.js"
      ],
      "run_at": "document_idle",
      "css": [
        "onhalo/tokens.css"
      ]
    },
    {
      "matches": [
        "https://haloplus.app/*",
        "https://richardsgeorger-collab.github.io/*"
      ],
      "js": [
        "content-dash.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sync-inject.js"
      ],
      "matches": [
        "https://halo.gcu.edu/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://gce-lms-resource-prod.s3.us-west-2.amazonaws.com/*"
  ]
}
